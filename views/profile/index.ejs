<div class="page-container">
  <div class="page-header">
    <h1>
      <span class="material-icons page-icon">person</span>
      Profil Saya
    </h1>
  </div>

  <div class="profile-grid">
    <div class="profile-info-card">
      <div class="profile-avatar">
        <span class="material-icons">account_circle</span>
      </div>
      <h2><%= profile.nama %></h2>
      <span class="badge badge-<%= profile.role %>"><%= profile.role === 'admin' ? 'Admin' : 'User' %></span>
      <div class="profile-details">
        <div class="profile-detail-item">
          <span class="material-icons">email</span>
          <span><%= profile.email %></span>
        </div>
        <% if (profile.alamat) { %>
          <div class="profile-detail-item">
            <span class="material-icons">location_on</span>
            <span><%= profile.alamat %></span>
          </div>
        <% } %>
        <% if (profile.noTelp) { %>
          <div class="profile-detail-item">
            <span class="material-icons">phone</span>
            <span><%= profile.noTelp %></span>
          </div>
        <% } %>
        <div class="profile-detail-item">
          <span class="material-icons">calendar_today</span>
          <span>Bergabung: <%= new Date(profile.createdAt).toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' }) %></span>
        </div>
      </div>
    </div>

    <div class="form-card">
      <div class="form-card-header">
        <span class="material-icons form-header-icon">edit</span>
        <h2>Edit Profil</h2>
      </div>

      <form action="/profile/edit" method="POST" class="profile-form">
        <div class="form-group">
          <label for="nama" class="form-label">
            <span class="material-icons">badge</span>
            Nama Lengkap
          </label>
          <input type="text" id="nama" name="nama" class="form-input" value="<%= profile.nama %>" required>
        </div>

        <div class="form-group">
          <label for="email" class="form-label">
            <span class="material-icons">email</span>
            Email
          </label>
          <input type="email" id="email" name="email" class="form-input" value="<%= profile.email %>" required>
        </div>

        <div class="form-group">
          <label for="alamat" class="form-label">
            <span class="material-icons">location_on</span>
            Alamat
          </label>
          <input type="text" id="alamat" name="alamat" class="form-input" value="<%= profile.alamat || '' %>" placeholder="Masukkan alamat">
        </div>

        <div class="form-group">
          <label for="noTelp" class="form-label">
            <span class="material-icons">phone</span>
            No. Telepon
          </label>
          <input type="text" id="noTelp" name="noTelp" class="form-input" value="<%= profile.noTelp || '' %>" placeholder="Masukkan no. telepon">
        </div>

        <div class="form-actions">
          <button type="submit" class="btn btn-primary">
            <span class="material-icons">save</span>
            Simpan Perubahan
          </button>
        </div>
      </form>
    </div>
  </div>
</div>
